{
  "name": "code-future-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python scripts/build-project-example.py && python scripts/build-assessments.py && python scripts/build-knowledge.py && node scripts/fit-slides.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import": "python scripts/import_course.py",
    "slides:fit": "node scripts/fit-slides.mjs",
    "example:build": "python scripts/build-project-example.py",
    "assessments:build": "python scripts/build-assessments.py",
    "knowledge:build": "python scripts/build-knowledge.py",
    "knowledge:verify": "python scripts/verify-knowledge.py"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
